LEARN_FILE = Path.home() / ".config" / "adaos" / "learn.json"


def load_learn() -> dict:
    """Lê o progresso. Se o arquivo faltar, estiver corrompido ou incompleto,
    corrige em vez de quebrar."""
    state = {"next": 0, "done": []}
    try:
        data = json.loads(LEARN_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return state
    if isinstance(data, dict):
        nxt = data.get("next", 0)
        if isinstance(nxt, int) and 0 <= nxt < len(LESSONS):
            state["next"] = nxt
        done = data.get("done", [])
        if isinstance(done, list):
            state["done"] = sorted({d for d in done if isinstance(d, int) and 0 <= d < len(LESSONS)})
    return state


# Palavras do dia a dia que levam a uma aula (palavra -> parte do título)
LESSON_KEYWORDS = {
    "atalho": "Atalhos", "atalhos": "Atalhos", "ctrl": "Atalhos", "teclado": "Atalhos",
    "log": "systemctl", "logs": "systemctl", "serviço": "systemctl", "servico": "systemctl",
    "permissão": "chmod", "permissao": "chmod", "script": "chmod", "executar": "chmod",
    "variável": "Variáveis", "variavel": "Variáveis", "export": "Variáveis", "which": "Variáveis",
    "compactar": "tar", "descompactar": "tar", "zip": "tar", "backup": "tar",
    "procurar": "grep", "buscar": "grep", "arquivo": "find",
    "copiar": "cp e mv", "mover": "cp e mv", "renomear": "cp e mv", "mv": "cp e mv", "cp": "cp e mv",
    "apagar": "rm", "deletar": "rm", "pasta": "mkdir", "criar": "mkdir",
    "processo": "ps, top", "processos": "ps, top", "top": "ps, top", "btop": "ps, top",
    "espaço": "df e du", "espaco": "df e du", "disco": "df e du", "df": "df e du",
    "rede": "ip e ping", "internet": "ip e ping", "ss": "ip e ping",
    "instalar": "sudo e apt", "pacote": "sudo e apt", "pacotes": "sudo e apt",
    "erro": "Redirecionar", "erros": "Redirecionar", "redirecionar": "Redirecionar", "/dev/null": "Redirecionar",
    "ajuda": "man, tldr", "tldr": "man, tldr", "help": "man, tldr", "manual": "man, tldr",
    "historico": "| (pipe)", "histórico": "| (pipe)", "history": "| (pipe)",
    "less": "cat, less", "head": "cat, less", "touch": "touch e echo", "wc": "sort, uniq",
    "sort": "sort, uniq", "chave": "ssh", "servidor": "ssh", "commit": "git", "baixar": "curl",
    "download": "curl", "pwd": "pwd", "onde": "pwd",
}


def find_lesson(term: str):
    """Procura a aula pelo assunto: primeiro a palavra exata, depois parte da palavra.
    (Assim 'ip' acha 'ip e ping', e não 'pipe'.)"""
    term = term.lower()
    words = [set(re.findall(r"[\w$]+", title.lower())) for title, *_ in LESSONS]
    for i, w in enumerate(words):
        if term in w or "$" + term in w:
            return i
    if term in LESSON_KEYWORDS:
        target = LESSON_KEYWORDS[term].lower()
        for i, (title, *_rest) in enumerate(LESSONS):
            if target in title.lower():
                return i
    for i, (title, *_rest) in enumerate(LESSONS):
        if term in title.lower():
            return i
    return None


def show_lesson(i: int) -> None:
    title, what, examples, exercise = LESSONS[i]
    print(f"{BRONZE_CLARO}{BOLD}Aula {i + 1} de {len(LESSONS)}: {title}{RESET}\n")
    print(f"  {MARFIM}{what}{RESET}\n")
    for ex in examples:
        cmd, _, note = ex.partition("   (")
        # Atalhos de teclado não são comandos: mostra ⌨ em vez do $
        prompt = "⌨" if cmd.startswith(("Ctrl", "Tab", "Alt")) else "$"
        print(f"  {BRONZE}{prompt}{RESET} {BOLD}{cmd}{RESET}" + (f"   {CINZA}({note}{RESET}" if note else ""))
    print(f"\n  {VERDE}✎ Exercício:{RESET} {exercise}")
    print(f"\n  {CINZA}Próxima aula: smart learn next · Todas: smart learn list · "
          f"Dúvida: explain <comando>{RESET}")


def cmd_learn(args: list, conf: dict) -> int:
    if any(a in ("help", "--help", "-h") for a in args):
        print(HELP["learn"])
        return 0
    # "smart learn explain git": explain é um comando sozinho (fora do smart learn)
    if args and args[0] in ("explain", "ask", "fix"):
        rest = " ".join(args[1:])
        print(f"{CINZA}(dica: {args[0]} é um comando sozinho: digite só {args[0]} {rest}){RESET}")
        if args[0] == "explain":
            return cmd_explain(args[1:], conf)
        return 2
    state = load_learn()
    if args and args[0] == "list":
        print(f"{BRONZE_CLARO}{BOLD}Aulas de terminal{RESET}\n")
        for i, (title, what, _e, _x) in enumerate(LESSONS):
            mark = f"{VERDE}✓" if i in state["done"] else f"{CINZA}·"
            print(f"  {mark} {i + 1:>2}. {title:<24}{RESET} {CINZA}{what}{RESET}")
        print(f"\n  {CINZA}{len(state['done'])} de {len(LESSONS)} vistas · smart learn <número> abre uma aula{RESET}")
        return 0
    if args and args[0] == "reset":
        state = {"next": 0, "done": []}
    elif args and args[0].isdigit():
        i = int(args[0]) - 1
        if not 0 <= i < len(LESSONS):
            error(f"escolha uma aula de 1 a {len(LESSONS)}")
            return 2
        state["next"] = i
    elif args and args[0] == "next":
        if state["next"] == len(LESSONS) - 1:
            vistas = len(set(state["done"]) | {state["next"]})
            print(f"{VERDE}{BOLD}★ Você chegou ao fim das {len(LESSONS)} aulas!{RESET} "
                  f"{CINZA}({vistas} de {len(LESSONS)} vistas){RESET}")
            print(f"{CINZA}Para treinar como num servidor: smart pure · "
                  f"Recomeçando pela aula 1:{RESET}\n")
        state["next"] = (state["next"] + 1) % len(LESSONS)
    elif args:
        # smart learn grep -> procura a aula pelo assunto
        found = find_lesson(" ".join(args))
        if found is None:
            error(f"não achei aula sobre '{' '.join(args)}'. Veja: smart learn list · "
                  f"para explicar um comando: explain {args[0]} · exemplos: tldr {args[0]}")
            return 2
        state["next"] = found
    i = state["next"]
    if i not in state["done"]:
        state["done"].append(i)
    try:
        LEARN_FILE.parent.mkdir(parents=True, exist_ok=True)
        LEARN_FILE.write_text(json.dumps(state))
    except OSError:
        error("não consegui salvar o progresso (a aula aparece normalmente)")
    show_lesson(i)
    return 0


# ----------------------------------------------------------------------------
# smart pure — modo treino: um Bash "de servidor", sem ajudas
# ----------------------------------------------------------------------------
PURE_RC = r'''
# Modo treino do Terminal Inteligente: Bash puro, como num servidor
PS1='\[\e[1;33m\][treino]\[\e[0m\] \u@\h:\w\$ '
HISTFILE="$HOME/.config/adaos/pure_history"
HISTSIZE=5000
HISTFILESIZE=5000
unset HISTCONTROL
unset command_not_found_handle
__pure_n=""
__pure_log() {
    local st=$? line n
    line=$(HISTTIMEFORMAT= history 1)
    n=$(printf '%s' "$line" | awk '{print $1}')
    if [ -z "$__pure_n" ]; then __pure_n="${n:-0}"; return; fi
    if [ -n "$n" ] && [ "$n" != "$__pure_n" ]; then
        __pure_n=$n
        printf '%s\t%s\n' "$st" "$(printf '%s' "$line" | sed 's/^ *[0-9]* *//')" >> "$PURE_LOG"
    fi
} 2>/dev/null
PROMPT_COMMAND=__pure_log
'''


def cmd_pure(args: list, conf: dict) -> int:
    if any(a in ("help", "--help", "-h") for a in args):
        print(HELP["pure"])
        return 0
    import tempfile
    import time
    local_bin = str(Path.home() / ".local" / "bin")
    path = ":".join(p for p in os.environ.get("PATH", "").split(":")
                    if p and os.path.realpath(p) != os.path.realpath(local_bin))
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("STARSHIP", "BAT_", "_ZO", "fish_", "__fish"))}
    env["PATH"] = path
    env["SHELL"] = shutil.which("bash") or "/bin/bash"

    (Path.home() / ".config" / "adaos").mkdir(parents=True, exist_ok=True)
    rc = tempfile.NamedTemporaryFile("w", suffix=".bashrc", delete=False)
    rc.write(PURE_RC)
    rc.close()
    log = tempfile.NamedTemporaryFile("w", suffix=".log", delete=False)
    log.close()
    env["PURE_LOG"] = log.name

    print(f"""{BRONZE_CLARO}{BOLD}Modo treino{RESET}  {CINZA}(Bash puro, como num servidor){RESET}

  Aqui {BOLD}não{RESET} tem: ask, explain, fix, smart, z, sugestão cinza, fzf, cores do exa/bat.
  Tem só o que todo Linux tem. Erros aparecem como num servidor:
  {CINZA}bash: comando: command not found{RESET}

  Ajuda que existe em qualquer servidor: {BRONZE}man <comando>{RESET} e {BRONZE}<comando> --help{RESET}
  Para sair e ver o resumo do treino: {BRONZE}exit{RESET} (ou Ctrl+D)""")
    state = load_learn()
    i = state.get("next", 0)
    if 0 <= i < len(LESSONS):
        print(f"\n  {VERDE}✎ Sugestão (aula {i + 1}, {LESSONS[i][0]}):{RESET} {LESSONS[i][3]}")
    print()

    start = time.time()
    try:
        subprocess.run([env["SHELL"], "--noprofile", "--rcfile", rc.name, "-i"], env=env)
    finally:
        os.unlink(rc.name)

    entries = []
    for line in Path(log.name).read_text(errors="replace").splitlines():
        st, _, cmd = line.partition("\t")
        if cmd.strip() and cmd.strip() != "exit":
            entries.append((st, cmd.strip()))
    os.unlink(log.name)

    minutes = (time.time() - start) / 60
    failed = [(st, c) for st, c in entries if st not in ("0", "")]
    print(f"\n{BRONZE_CLARO}{BOLD}Resumo do treino{RESET}  {CINZA}({minutes:.0f} min){RESET}".replace(".", ","))
    if not entries:
        print(f"  {CINZA}Nenhum comando digitado.{RESET}")
        return 0
    ok = len(entries) - len(failed)
    print(f"  Comandos digitados: {len(entries)}   {VERDE}✓ {ok} certos{RESET}   "
          f"{(VINHO + '✗ ' + str(len(failed)) + ' com erro') if failed else CINZA + '✗ 0 com erro'}{RESET}")
    progs = {}
    for _st, c in entries:
        word = c.split()[0]
        if word == "sudo" and len(c.split()) > 1:
            word = c.split()[1]
        progs[word] = progs.get(word, 0) + 1
    top = sorted(progs.items(), key=lambda kv: -kv[1])[:8]
    print(f"  Mais usados: {', '.join(f'{p} ({n})' for p, n in top)}")
    # Hábitos do terminal inteligente / do Fish que não funcionam num servidor
    tips = []
    for st, c in entries:
        word = c.split()[0]
        if re.match(r"set\s+-[gUl]*x\b", c):
            tips.append(f"'{c}': no Bash, crie variáveis com {BOLD}export NOME=valor{RESET}. "
                        f"Lá, set -x liga o modo de depuração (linhas com +); desliga com set +x")
        elif word in ("ask", "explain", "fix", "smart", "z", "zi") and st == "127":
            tips.append(f"'{word}' é do seu terminal inteligente; num servidor não existe. "
                        f"Use man {c.split()[1] if len(c.split()) > 1 and word == 'explain' else '<comando>'} "
                        f"ou <comando> --help")
        elif word in ("ll", "la") and st == "127":
            tips.append(f"'{word}' é um apelido; o comando padrão é ls -l (ou ls -la)")
        elif re.search(r"(^|[^$])\((?!\))[a-z]", c) and "$(" not in c and not c.startswith(("for", "while", "if")):
            tips.append(f"'{c}': no Bash, o resultado de um comando é {BOLD}$(comando){RESET}, não (comando)")
        elif re.match(r"(if|for|while)\b.*\bend\s*$", c):
            tips.append(f"'{c}': no Bash, if termina com fi e for/while com done (end é do Fish)")
    if tips:
        print(f"\n  {BRONZE}Hábitos do Fish/terminal inteligente que apareceram:{RESET}")
        for t in dict.fromkeys(tips):
            print(f"    • {t}")
    if failed:
        print(f"\n  {VINHO}Comandos com erro{RESET} {CINZA}(código de saída entre colchetes){RESET}")
        for st, c in failed[-10:]:
            print(f"    [{st}] {c}")
        print(f"\n  {CINZA}Para entender um erro: explain <comando>  ·  "
              f"127 = comando não existe · 1/2 = opção ou arquivo errado · 126 = sem permissão{RESET}")
    return 0


# ----------------------------------------------------------------------------
# smart dino — o jogo (arquivo separado: adaos-dino)
# ----------------------------------------------------------------------------
def cmd_dino(args: list, conf: dict) -> int:
    here = Path(__file__).resolve().parent / "adaos-dino"
    game = here if here.exists() else Path.home() / ".local" / "bin" / "adaos-dino"
    if not game.exists():
        error("o jogo não está instalado. Rode de novo: bash instalar.sh")
        return 1
    os.execv(sys.executable, [sys.executable, str(game), *args])


